PORT=4000
DB_PATH=./data/serverhub.db
JWT_SECRET=change-me-in-production-min-32-chars
# 64-char hex (32 bytes). Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SERVERHUB_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Comma-separated to allow several origins, e.g. http://localhost:6540,http://localhost:5173
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
CADDYFILE_PATH=/etc/caddy/Caddyfile
HEALTH_CHECK_INTERVAL_SEC=60
# Shared secret for GitHub webhook HMAC verification (repo settings → webhooks).
# If unset, POST /server-hub/api/webhooks/github returns 503.
GITHUB_WEBHOOK_SECRET=
# Comma-separated host roots scanned for project signatures (package.json,
# go.mod, Dockerfile, docker-compose.* …). Empty disables directory scan.
# Inside Docker, mount each root (e.g. - /srv/apps:/srv/apps:ro).
SCAN_ROOTS=/srv/apps
# Where project snapshots are stored.
BACKUP_DIR=./data/backups
# Resource alert thresholds (percent) — rising-edge events + audit entries.
ALERT_CPU_PCT=85
ALERT_RAM_PCT=90
ALERT_DISK_PCT=80
