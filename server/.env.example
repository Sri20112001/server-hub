# ServerHub backend environment. Copy to `.env` and fill in real values:
#   cp .env.example .env
# NEVER commit `.env` with real secrets.
#
# For `docker compose`: POSTGRES_PASSWORD is REQUIRED (Compose fails closed
# without it). Postgres is published on 127.0.0.1 only — see docker-compose.yml.

PORT=4000

# Runtime mode: development (default, convenient) or production (fail-fast:
# missing/invalid SERVERHUB_ENCRYPTION_KEY or COOKIE_SECURE=false aborts
# startup). docker-compose.yml defaults to production.
# SERVERHUB_ENV=development
# (APP_ENV / GO_ENV are accepted as fallbacks.)
SERVERHUB_ENV=development

# Compose publish binding: loopback-only by default (see docker-compose.yml).
# SERVERHUB_BIND=127.0.0.1
# SERVERHUB_PORT=4000

# Postgres DSN for `go run ./cmd/server` (local dev, no Docker).
# The password here must match your local Postgres `serverhub` role.
DATABASE_URL=postgres://serverhub:CHANGE-ME@localhost:5432/serverhub?sslmode=disable

# Auth: MUST be at least 32 characters. Generate:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE-ME-TO-64-HEX-CHARS-MIN-32-CHARS-LONG

# Secret encryption: stable 64-char hex (32 bytes). Losing/changing this key
# makes all stored secrets undecryptable. Generate:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SERVERHUB_ENCRYPTION_KEY=CHANGE-ME-TO-64-HEX-CHARS

# First admin account, seeded on first run only (changing it later does NOT
# reset the password — use Settings or the users API instead).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-MIN-8-CHARS

# Browser origins allowed by CORS (comma-separated, scheme+host only —
# NEVER include a path: use https://imagesoft.in, not
# https://imagesoft.in/server-hub). The Vite app base path (/server-hub/)
# is unrelated to CORS. FRONTEND_URL is still honoured as a legacy fallback
# (its path part, if any, is stripped with a startup warning).
FRONTEND_ORIGIN=http://localhost:6540
# Comma-separated allowed browser origins (the API also allows
# http://localhost:5173 and http://localhost:3000).
FRONTEND_URL=http://localhost:6540

# Docker-Compose Postgres (used only by `docker compose`, ignored by `go run`).
POSTGRES_DB=serverhub
POSTGRES_USER=serverhub
POSTGRES_PASSWORD=CHANGE-ME-STRONG-PASSWORD
# Host port for Postgres (127.0.0.1 only). 5432 is the default; use 5434 if
# the host already runs Postgres (the Jenkins deploy does this).
POSTGRES_PORT=5432

CADDYFILE_PATH=/etc/caddy/Caddyfile
HEALTH_CHECK_INTERVAL_SEC=60
# Must be true whenever the API is served over HTTPS (i.e. behind your
# TLS reverse proxy). Keep false for plain-http local dev only.
COOKIE_SECURE=false
# Comma-separated roots for the shipyard discovery scan.
SCAN_ROOTS=/srv/apps
# Allowed roots for project deployment_path values. Deploy, rollback,
# lifecycle and restore resolve symlinks and refuse anything outside these
# roots. Defaults to SCAN_ROOTS — always set explicitly in production.
# DEPLOY_ROOTS=/srv/apps
# Strict egress for health polling (deny loopback/private/link-local after
# DNS). Default false: metadata-IP + no-redirect guardrails always apply,
# but private targets stay allowed (monitoring internal services is the
# feature's job). Enable for locked-down deployments + network egress policy.
# HEALTHCHECK_EGRESS_STRICT=false
# HMAC secret for GitHub webhooks. If unset, the webhook endpoint returns 503.
GITHUB_WEBHOOK_SECRET=

# Prometheus integration (optional — leave URL blank to disable).
# When set, Server Hub proxies Prometheus queries through authenticated API endpoints.
# PROMETHEUS_ENABLED=false disables it without clearing the URL.
PROMETHEUS_ENABLED=true
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SEC=10

# Alertmanager integration (optional — leave URL blank to disable).
# ALERTMANAGER_ENABLED=false disables it without clearing the URL.
ALERTMANAGER_ENABLED=true
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_TIMEOUT_SEC=10

# Shared secret for the Alertmanager webhook endpoint.
# Set the same value in alertmanager.yml under http_config.headers.X-Alertmanager-Secret.
# Leave blank to accept unauthenticated webhooks (only safe on a private network).
ALERTMANAGER_WEBHOOK_SECRET=

# Offline detection: a managed server with no heartbeat for this long is
# reported OFFLINE/DISCONNECTED (minimum 30, default 180).
SERVER_OFFLINE_TIMEOUT_SEC=180

# server_metrics retention: snapshots older than this many days are pruned
# hourly (1..365, default 30 — the largest history range the UI supports).
# Invalid values fall back to 30; only server_metrics rows are ever deleted.
SERVER_METRICS_RETENTION_DAYS=30

# Operational app_logs retention (default 90, min 30): rows older than this
# are pruned hourly in bounded batches. audit_logs is NEVER pruned (fully
# immutable trigger, no exception); the DB trigger independently rejects
# app_logs deletes newer than 30 days.
# APPLOG_RETENTION_DAYS=90
# Raw health-check probe results (default 30, min 1). Alerts persist separately.
# HEALTHCHECK_RESULTS_RETENTION_DAYS=30
# Terminal delivery outbox rows, attempts and flushed digests (default 90,
# min 1). Firing incident states and audit logs are never pruned.
# DELIVERY_RETENTION_DAYS=90
