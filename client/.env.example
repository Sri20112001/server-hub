# ServerHub web client example. Copy to `.env` and adjust:
#   cp .env.example .env
# NEVER put secrets in VITE_* variables — they ship to the browser.

# Backend origin (default http://localhost:4000 when unset).
# VITE_API_URL=http://localhost:4000

# File Transfers are served by the ServerHub backend itself
# (/server-hub/api/transfers/*); no extra env is needed. If
# FILE_STORAGE_ROOT is unset server-side, the section reports as disabled.
